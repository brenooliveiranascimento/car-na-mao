# Copie para .env (o docker compose lê este arquivo automaticamente). Nunca commite o .env.

# --- Produção (VPS) ---
POSTGRES_PASSWORD=troque-por-uma-senha-forte
API_PORT=3010
WEB_PORT=3011
CORS_ORIGIN=https://carnamao.seudominio.com.br

# --- IA ---
# "mock" funciona sem chave (respostas-modelo). Use "gemini" com a chave para explicações reais.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Site ---
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/SEU-USUARIO/car-na-mao
NEXT_PUBLIC_CONTACT_EMAIL=
