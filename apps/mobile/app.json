{
  "expo": {
    "name": "CAR na Mão",
    "slug": "car-na-mao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.org.carnamao.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.org.carnamao.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "carnamao",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O CAR na Mão usa a localização para registrar o limite do seu imóvel enquanto você caminha."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}